# Copie para .env e ajuste para a conexao oficial do grupo.
SECRET_KEY=substitua-por-uma-chave-aleatoria-longa
JWT_SECRET_KEY=substitua-por-outra-chave-aleatoria-longa
JWT_EXPIRES_SECONDS=3600
DATABASE_URL=sqlite:///dev.db
# Origens liberadas para o front-end (separadas por virgula).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Fuso do haras e antecedencia do alerta de quebra de estoque (em dias).
TIMEZONE=America/Sao_Paulo
ALERTA_DIAS_ANTECEDENCIA=5
# Nivel dos logs no console: DEBUG, INFO, WARNING ou ERROR.
LOG_LEVEL=INFO
# Para PostgreSQL, configure a URL real e instale o extra postgres.
# Nunca versionar .env ou arquivos do banco.
