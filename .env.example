# ---------------------------------------------------------------------------
# EstoqueFacil - variaveis de ambiente do backend
# Copie para .env (na raiz do repositorio ou em backend/) e ajuste.
# O .env NUNCA vai para o Git.
# ---------------------------------------------------------------------------

# Chave do Flask. Em producao e obrigatoria e nao pode ser o valor padrao.
SECRET_KEY=substitua-por-uma-chave-aleatoria-longa

# Chave que assina os tokens JWT. Obrigatoria em producao (>= 32 caracteres).
JWT_SECRET_KEY=substitua-por-outra-chave-aleatoria-longa

# Validade do token de acesso, em segundos (3600 = 1 hora).
JWT_EXPIRES_SECONDS=3600

# Banco de dados. SQLite em desenvolvimento; para PostgreSQL use
# postgresql://usuario:senha@host:5432/estoquefacil e instale o extra postgres.
DATABASE_URL=sqlite:///dev.db

# Origens liberadas para o front-end (Vue), separadas por virgula.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fuso do haras: define o "hoje" do registro diario e a previsao de ruptura.
TIMEZONE=America/Sao_Paulo

# Quantos dias antes da quebra de estoque o alerta "atencao" comeca.
ALERTA_DIAS_ANTECEDENCIA=5

# Nivel dos logs no console: DEBUG, INFO, WARNING ou ERROR.
LOG_LEVEL=INFO
